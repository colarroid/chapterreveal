# Copy to .env.local and fill in.

# Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deepgram: console.deepgram.com > API Keys. Server only, never exposed to the browser.
# The key needs the Member role or higher so it can mint short-lived tokens.
DEEPGRAM_API_KEY=your-deepgram-key

# Shows "Continue with Google" on sign in and sign up. Set to 1 only after
# enabling Google in Supabase (Authentication > Providers > Google).
NEXT_PUBLIC_GOOGLE_AUTH=0

# Cloudinary: projector backgrounds (Settings > Display). console.cloudinary.com > Settings > API Keys.
# The secret is server only; never prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Weekly summary email (every Monday, vercel.json cron). All server only.
# Supabase: Settings > API > service_role. The weekly job reads every church with it.
SUPABASE_SERVICE_ROLE_KEY=
# Resend: resend.com > API Keys. The sending domain must be verified in Resend.
RESEND_API_KEY=
# Optional: the From address. Defaults to "ReedArk <summary@reedark.com>".
SUMMARY_FROM=
# Anthropic: console.anthropic.com > API Keys. Writes the sermon summaries;
# the Monday email isn't sent until this is set.
ANTHROPIC_API_KEY=
# Vercel sets this on the project; it stops anyone else starting the weekly job.
CRON_SECRET=
